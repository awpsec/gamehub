{
  "name": "gamehub-client",
  "productName": "Gamehub",
  "version": "1.8.11",
  "description": "Gamehub desktop client: browse the server library, download, unpack, install, and play",
  "author": "Gamehub",
  "main": "main.js",
  "scripts": {
    "sync-server": "node scripts/sync-embedded-server.mjs",
    "probe-installers": "node scripts/probe-silent-installers.mjs",
    "start": "npm run sync-server && electron .",
    "dist": "npm run sync-server && electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "better-sqlite3": "^12.4.1",
    "electron-updater": "^6.3.9",
    "express": "^4.21.0",
    "hls.js": "^1.6.16"
  },
  "build": {
    "appId": "com.gamehub.client",
    "productName": "Gamehub",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "assets/**/*",
      "embedded/**/*"
    ],
    "asarUnpack": [
      "node_modules/**",
      "embedded/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "awpsec",
        "repo": "gamehub",
        "private": true,
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "menuCategory": "Gamehub",
      "shortcutName": "Gamehub"
    }
  }
}
